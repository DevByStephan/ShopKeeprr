APP_NAME=ShopKeeprr
APP_ENV=local
VERSION=1.1.0
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Signed updates
# -----------------------------------------------------------------------------
# Signed release manifest published by the vendor. Must be HTTPS.
SHOPKEEPRR_UPDATE_URL=https://updates.shopkeeprr.com/manifest.json
SHOPKEEPRR_UPDATE_CHANNEL=stable
SHOPKEEPRR_UPDATES_ENABLED=true
# SHOPKEEPRR_UPDATE_PUBLIC_KEY=
# SHOPKEEPRR_UPDATE_BACKUP_KEEP=5
# SHOPKEEPRR_UPDATE_TIMEOUT=20
# SHOPKEEPRR_UPDATE_DOWNLOAD_TIMEOUT=600
# SHOPKEEPRR_UPDATE_MAX_MB=150
# Optional absolute path to the PHP CLI binary used for migrations.
# SHOPKEEPRR_PHP_BINARY=/usr/local/bin/php

# -----------------------------------------------------------------------------
# ShopKeeprr Store marketplace
# -----------------------------------------------------------------------------
SHOPKEEPRR_STORE_URL=https://store.shopkeeprr.com
# Local development only. Keep this false in production.
SHOPKEEPRR_STORE_ALLOW_HTTP=false
SHOPKEEPRR_STORE_TIMEOUT=20
SHOPKEEPRR_STORE_CATALOG_TTL=300
SHOPKEEPRR_STORE_MAX_PACKAGE_MB=20

# Installation tracking (off by default; Store endpoint)
# When enabled, the payload includes a pseudonymous install ID and the
# administrator email, plus site/version/environment metadata.
SHOPKEEPRR_TRACKING_ENABLED=false
SHOPKEEPRR_TRACKING_URL=https://store.shopkeeprr.com/api/v1/installs
SHOPKEEPRR_TRACKING_TIMEOUT=8
